        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a86" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>в свою /пе̲рвую школу,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a87" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>(которую я покинула),</ANNOTATION_VALUE>
